# ==============================
# Application
# ==============================
APP_NAME=Customer Support AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# ==============================
# Server
# ==============================
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173


# ==============================
# Database (choose ONE: postgres or mongo)
# ==============================
DATABASE_TYPE=postgres

# PostgreSQL
POSTGRES_URL=postgresql://postgres:password@localhost:5432/customer_support_ai

# SQLite (only used if DATABASE_TYPE=sqlite - handy for local dev without installing Postgres)
SQLITE_URL=sqlite:///./app.db

# MongoDB (used only if DATABASE_TYPE=mongo)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=customer_support_ai

# ==============================
# JWT Authentication
# ==============================
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================
# LLM Provider (choose ONE: openai or anthropic)
# ==============================
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ==============================
# RAG / Vector Store
# ==============================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=backend/vectorstore/faiss_index
KNOWLEDGE_BASE_PATH=knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=4

# ==============================
# Logging
# ==============================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
